   "cell_type": "code",
   "source": [
    "from langchain_deepseek import ChatDeepSeek\n",
    "from dotenv import load_dotenv\n",
    "\n",
    "# 从 .env 文件中加载环境变量\n",
    "load_dotenv(override=True)\n",
    "\n",
    "model = ChatDeepSeek(\n",
    "model=\"deepseek-v4-flash\",\n",
    "temperature=0.7,\n",
    "max_tokens=1000,\n",
    "max_retries=6\n",
    ")\n",
    "\n",
    "print(model.profile)"
   ],
